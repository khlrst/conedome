/// Storage offset to prevent collisions with other delegation contracts.
/// keccak256("Conedome.1.0")
#define constant STORAGE_OFFSET = 0xe60d27b7f8f053028d8c0ad54161daa8c5c129ee9c990230f8b2566e6d766325
/// Pointer to the program counter in the heap.
#define constant PROGRAM_COUNTER = 0x00
/// Amount of bits to shift to isolate an opcode from the calldata slot.
#define constant SINGLE_OPCODE = 0xf8
/// Size of the opcode table in bytes.
#define constant TABLE_SIZE = 0x06
/// Glamsterdam table size in bytes.
#define constant GLAMSTERDAM_TABLE_SIZE = 0x02
/// Hex representation of 1 byte.
#define constant ONE_BYTE = 0x01
/// Hex representation of one word (32 bytes).
#define constant ONE_WORD = 0x20

/// Executes arbitrary opcode suquence from the calldata.
/// Contains a table for each opcode at predictable offset.
/// Jumps to the opcode table to execute it.
/// NOTE: some opcodes have nested table jumps to stay at predictable offset.
#define macro MAIN() = takes (0) returns (0) {

    [PROGRAM_COUNTER] msize mstore // initialize program counter

    loop:
        [PROGRAM_COUNTER] mload // load program counter
        calldataload [SINGLE_OPCODE] shr // load next opcode
        [TABLE_SIZE] mul // multiply by table size to get offset
        x00 add // add to table fisrt opcode offset
        jump // jump to opcode implementation

    move:
        [PROGRAM_COUNTER] mload // load program counter
        [ONE_BYTE] add // increment the program counter
        [PROGRAM_COUNTER] mstore // store the updated program counter
        loop jump // loop to the next opcode

        //////////////////////////////////////////////////////
       ///                                                ///
      ///             OPCODE IMPLEMENTATIONS             ///
     ///                                                ///
    //////////////////////////////////////////////////////

    impl_call:
        // increase offsets by one memory slot to respect reserved PC memory slot
        swap4 [ONE_WORD] add swap4 
        swap6 [ONE_WORD] add swap6
        call
        move jump

    impl_delegatecall:
        // increase offsets by one memory slot to respect reserved PC memory slot
        swap3 [ONE_WORD] add swap3 
        swap5 [ONE_WORD] add swap5
        delegatecall
        move jump

    impl_callcode:
        // increase offsets by one memory slot to respect reserved PC memory slot
        swap4 [ONE_WORD] add swap4 
        swap6 [ONE_WORD] add swap6
        callcode
        move jump

    impl_staticcall:
        // increase offsets by one memory slot to respect reserved PC memory slot
        swap3 [ONE_WORD] add swap3 
        swap5 [ONE_WORD] add swap5
        staticcall
        move jump

    impl_log0:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        log0
        move jump

    impl_log1:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        log1
        move jump

    impl_log2:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        log2
        move jump

    impl_log3:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        log3
        move jump

    impl_log4:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        move jump

    impl_create:
        swap2 [ONE_WORD] add swap2 // increase offset by one memory slot to respect reserved PC memory slot
        create
        move jump

    impl_create2:
        swap2 [ONE_WORD] add swap2 // increase offset by one memory slot to respect reserved PC memory slot
        create2
        move jump

    impl_codecopy:
        // increase offset by one memory slot to respect reserved PC memory slot
        [ONE_WORD] add
        swap2 [ONE_WORD] add swap2
        codecopy
        move jump

    impl_extcodecopy:
        // increase offset by one memory slot to respect reserved PC memory slot
        swap2 [ONE_WORD] add swap2
        swap3 [ONE_WORD] add swap3
        extcodecopy
        move jump

    impl_returndatacopy:
        // increase offset by one memory slot to respect reserved PC memory slot
        [ONE_WORD] add
        swap2 [ONE_WORD] add swap2
        returndatacopy
        move jump

    impl_mstore:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        mstore
        move jump

    impl_mstore8:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        mstore8
        move jump

    impl_mload:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        mload
        move jump

    impl_mcopy:
        // increase offset by one memory slot to respect reserved PC memory slot
        [ONE_WORD] add
        swap2 [ONE_WORD] add swap2
        mcopy
        move jump

    impl_msize:
        // Decrease size by one word to match actual memory usage
        msize [ONE_WORD] sub
        move jump

    impl_return:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        return

    impl_revert:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        revert

    impl_keccak256:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        keccak256
    
    impl_calldatacopy:
        [ONE_WORD] add // increase offset by one memory slot to respect reserved PC memory slot
        calldatacopy

    impl_sstore:
        [STORAGE_OFFSET] add // add storage offset to current pointer on the stack
        sstore
        move jump

    impl_sload:
        [STORAGE_OFFSET] add // add storage offset to current pointer on the stack
        sload
        move jump

    impl_push32:
        [PROGRAM_COUNTER] mload // get the program counter
        [ONE_BYTE] add // increment to the push value offset
        dup1 // copy the offset to the value
        calldataload // load value on the stack, now only one offset is on the stack
        swap1 // swap the value and remaining offset
        [ONE_WORD] add // add word length to the remaining offset
        [PROGRAM_COUNTER] mstore // store the updated program counter
        loop jump // jump to the loop table right away due to 33 byte counter increase

    invalid_jump:
        0x00 0x00 revert

    // TODO: this is optimistic jump implementation, interpreter might hit a random matching byte.
    // Need to implement jumpdest scan later.
    impl_jump:
        dup1 // copy jump dest
        calldataload [SINGLE_OPCODE] shr // get the opcode at the jump dest
        0x5b eq // compare the opcode to the jumpdest opcode
        iszero // check if it is correct jumpdest
        invalid_jump jumpi // revert if dest is not jumpdest
        [PROGRAM_COUNTER] mstore // update pc with the jumpdest
        loop jump // proceed from the jumpdest
    
    impl_jumpi:
        impl_jump jumpi
        move jump


    impl_swapn:
        [PROGRAM_COUNTER] [ONE_BYTE] add mload // load program counter
        calldataload [SINGLE_OPCODE] shr // load next opcode
        [GLAMSTERDAM_TABLE_SIZE] mul // multiply by glamsterdam table size to get offset
        swapn_17 add // add to table fisrt opcode offset
        jump
    
    impl_dupn:
        [PROGRAM_COUNTER] [ONE_BYTE] add mload // load program counter
        calldataload [SINGLE_OPCODE] shr // load next opcode
        [GLAMSTERDAM_TABLE_SIZE] mul // multiply by glamsterdam table size to get offset
        dupn_17 add // add to table fisrt opcode offset
        jump

    impl_exchange:

        //////////////////////////////////////////////////////
       ///                                                ///
      ///                OPCODE JUMPTABLES               ///
     ///                                                ///
    //////////////////////////////////////////////////////
    x00:
        stop
        invalid invalid invalid invalid

    x01:
        add move jump

    x02:
        mul move jump

    x03:
        sub move jump

    x04:
        div move jump

    x05:
